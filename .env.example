# Variables de entorno para Backend_Mig - Railway Template
# Estas variables se configurarán en Railway Dashboard

# Database (Railway MySQL Service - Se autocompletarán)
MYSQLHOST=${{MySQL.MYSQLHOST}}
MYSQLPORT=${{MySQL.MYSQLPORT}}
MYSQLDATABASE=${{MySQL.MYSQLDATABASE}}
MYSQLUSER=${{MySQL.MYSQLUSER}}
MYSQLPASSWORD=${{MySQL.MYSQLPASSWORD}}

# JWT Configuration - Configurar manualmente en Railway
JWT_SECRET=${{JWT_SECRET}}
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Server Configuration
PORT=${{PORT}}
NODE_ENV=production
FRONTEND_URL=${{FRONTEND_URL}}

# Email Providers - Agregar manualmente en Railway
BREVO_API_KEY=${{BREVO_API_KEY}}
RESEND_API_KEY=${{RESEND_API_KEY}}
SENDGRID_API_KEY=${{SENDGRID_API_KEY}}
MAILGUN_API_KEY=${{MAILGUN_API_KEY}}
MAILGUN_DOMAIN=${{MAILGUN_DOMAIN}}

# SMTP Configuration (fallback) - Configurar en Railway
MAIL_HOST=${{MAIL_HOST}}
MAIL_PORT=587
MAIL_USERNAME=${{MAIL_USERNAME}}
MAIL_PASSWORD=${{MAIL_PASSWORD}}

# SMS Configuration - Usar TextBelt en Railway
TEXTBELT_API_KEY=${{TEXTBELT_API_KEY}}

# Security Configuration
TWO_FACTOR_ISSUER=AuthSystem
RATE_LIMIT_MAX_ATTEMPTS=5
LOCKOUT_DURATION=900000

# Email Verification
EMAIL_VERIFICATION_EXPIRATION=86400000
SMS_VERIFICATION_EXPIRATION=300000
SMS_MAX_ATTEMPTS=3