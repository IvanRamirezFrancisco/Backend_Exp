# ========================================
# RAILWAY PRODUCTION VARIABLES - BACKEND
# ========================================
# Configura estas variables en Railway Dashboard

# 🗄️ DATABASE CONFIGURATION
MYSQLHOST=containers-us-west-XXX.railway.app
MYSQLPORT=XXXX
MYSQLDATABASE=railway
MYSQLUSER=root
MYSQLPASSWORD=TU_PASSWORD_MYSQL_DE_RAILWAY

# 🔐 JWT CONFIGURATION
JWT_SECRET=TU_JWT_SECRET_SUPER_SEGURO_AQUI_64_CARACTERES_MINIMO
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# 🌐 SERVER CONFIGURATION
PORT=8080
NODE_ENV=production
FRONTEND_URL=https://frontendexp-production.up.railway.app

# 📧 EMAIL PROVIDERS
# IMPORTANTE: Genera una nueva API key en Brevo Dashboard
BREVO_API_KEY=TU_NUEVA_API_KEY_BREVO_AQUI

# 📱 SMS CONFIGURATION
TEXTBELT_API_KEY=TU_API_KEY_TEXTBELT_AQUI

# ⚙️ EMAIL SMTP CONFIG
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=TU_EMAIL_VERIFICADO_EN_BREVO
MAIL_PASSWORD=TU_SMTP_PASSWORD_BREVO

# 🛡️ SECURITY SETTINGS
TWO_FACTOR_ISSUER=AuthSystem
RATE_LIMIT_MAX_ATTEMPTS=5
LOCKOUT_DURATION=900000

# ⏱️ VERIFICATION SETTINGS
EMAIL_VERIFICATION_EXPIRATION=86400000
SMS_VERIFICATION_EXPIRATION=300000
SMS_MAX_ATTEMPTS=3

# 🧪 PRODUCTION SETTINGS
CREATE_DEFAULT_ADMIN=false
SKIP_RATE_LIMIT=true